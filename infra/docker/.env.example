# Quant Academy — local docker-compose environment
# Copy to .env and override as needed.

# --- API (FastAPI) ---
QA_ENV=dev
QA_LOG_LEVEL=info
QA_DATABASE_URL=postgresql+psycopg://qa:qa@postgres:5432/qa
QA_REDIS_URL=redis://redis:6379/0
QA_SECRET_KEY=change-me-in-prod

# --- Postgres ---
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa
POSTGRES_DB=qa

# --- Web (Next.js) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Quant Academy
