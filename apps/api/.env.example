# Quant Academy API environment variables.
# Copy to .env and fill in real values for local development.

QA_ENV=dev
QA_CORS_ORIGINS=["http://localhost:3000"]
QA_DATABASE_URL=postgresql://qa:qa@localhost:5432/qa
QA_REDIS_URL=redis://localhost:6379/0

# Anthropic — used by /ai/tutor (M4).
QA_ANTHROPIC_API_KEY=

# Clerk JWKS endpoint — used by auth middleware (M3).
QA_CLERK_JWKS_URL=

# Market data providers (M5).
QA_POLYGON_API_KEY=
QA_ALPHA_VANTAGE_API_KEY=
