# ============================================================================
# Quant Academy — apps/web environment example
# Copy to apps/web/.env.local for local development.
# ============================================================================

# ---- Auth ------------------------------------------------------------------

# REQUIRED in production. Must be 'clerk' or 'dev'.
# Unset (or any other value) in production causes getAuthMode() to throw —
# this is intentional, to fail closed. Local dev may omit the var and get
# dev mode automatically (cookie-based stub auth).
QA_AUTH_MODE=dev

# Clerk credentials — required when QA_AUTH_MODE=clerk.
# Get from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---- Database --------------------------------------------------------------

# Required for any DB-backed flow (lessons progress, backtest persistence,
# AI tutor history). docker-compose.yml provisions this at the default URL.
QA_DATABASE_URL=postgres://qa:qa@localhost:5432/qa

# ---- API ------------------------------------------------------------------

# FastAPI base URL. Server-side only; never exposed to the browser.
QA_API_BASE=http://localhost:8000

# ---- AI tutor --------------------------------------------------------------

# Optional. When unset, the tutor renders an "unavailable" message and
# tests / build still pass. When set, requests stream from Anthropic.
ANTHROPIC_API_KEY=

# ---- Build / runtime -------------------------------------------------------

# NODE_ENV is set automatically by Next.js; do not override here.
